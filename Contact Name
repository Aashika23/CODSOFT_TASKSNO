import json
import os

FILE_NAME = "contacts.json"


# Load contacts from file
def load_contacts():
    if os.path.exists(FILE_NAME):
        try:
            with open(FILE_NAME, "r") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError):
            return []
    return []


# Save contacts to file
def save_contacts(contacts):
    with open(FILE_NAME, "w") as file:
        json.dump(contacts, file, indent=4)


# Add a new contact
def add_contact(contacts):
    print("\n--- Add New Contact ---")

    name = input("Enter name: ").strip()
    phone = input("Enter phone number: ").strip()
    email = input("Enter email: ").strip()
    address = input("Enter address: ").strip()

    if not name or not phone:
        print("Name and phone number are required!")
        return

    # Check for duplicate phone numbers
    if any(c["phone"] == phone for c in contacts):
        print("A contact with this phone number already exists!")
        return

    contact = {
        "name": name,
        "phone": phone,
        "email": email,
        "address": address
    }

    contacts.append(contact)
    save_contacts(contacts)
    print("Contact added successfully!")


# View all contacts
def view_contacts(contacts):
    print("\n--- Contact List ---")

    if not contacts:
        print("No contacts found.")
        return

    for i, contact in enumerate(contacts, start=1):
        print(f"\nContact {i}")
        print("Name   :", contact["name"])
        print("Phone  :", contact["phone"])
        print("Email  :", contact["email"])
        print("Address:", contact["address"])


# Search contacts by name or phone number
def search_contact(contacts):
    query = input(
        "\nEnter name or phone number to search: "
    ).strip().lower()

    results = [
        c for c in contacts
        if query in c["name"].lower()
        or query in c["phone"].lower()
    ]

    if results:
        print("\n--- Search Results ---")
        view_contacts(results)
    else:
        print("No matching contact found.")


# Update a contact
def update_contact(contacts):
    phone = input(
        "\nEnter the current phone number of the contact: "
    ).strip()

    contact = next(
        (c for c in contacts if c["phone"] == phone),
        None
    )

    if contact is None:
        print("Contact not found!")
        return

    print("Press Enter to keep the existing value.")

    name = input(f"New name [{contact['name']}]: ").strip()
    new_phone = input(
        f"New phone [{contact['phone']}]: "
    ).strip()
    email = input(f"New email [{contact['email']}]: ").strip()
    address = input(
        f"New address [{contact['address']}]: "
    ).strip()

    # Prevent duplicate phone numbers
    if new_phone and any(
        c["phone"] == new_phone and c is not contact
        for c in contacts
    ):
        print("Another contact already uses that phone number!")
        return

    if name:
        contact["name"] = name
    if new_phone:
        contact["phone"] = new_phone
    if email:
        contact["email"] = email
    if address:
        contact["address"] = address

    save_contacts(contacts)
    print("Contact updated successfully!")


# Delete a contact
def delete_contact(contacts):
    phone = input(
        "\nEnter the phone number of the contact to delete: "
    ).strip()

    contact = next(
        (c for c in contacts if c["phone"] == phone),
        None
    )

    if contact is None:
        print("Contact not found!")
        return

    confirm = input(
        f"Delete contact '{contact['name']}'? (yes/no): "
    ).strip().lower()

    if confirm in ("yes", "y"):
        contacts.remove(contact)
        save_contacts(contacts)
        print("Contact deleted successfully!")
    else:
        print("Deletion cancelled.")


# Main menu
def main():
    contacts = load_contacts()

    while True:
        print("\n==============================")
        print("   CONTACT MANAGEMENT SYSTEM")
        print("==============================")
        print("1. Add Contact")
        print("2. View All Contacts")
        print("3. Search Contact")
        print("4. Update Contact")
        print("5. Delete Contact")
        print("6. Exit")
        print("==============================")

        choice = input("Enter your choice (1-6): ").strip()

        if choice == "1":
            add_contact(contacts)
        elif choice == "2":
            view_contacts(contacts)
        elif choice == "3":
            search_contact(contacts)
        elif choice == "4":
            update_contact(contacts)
        elif choice == "5":
            delete_contact(contacts)
        elif choice == "6":
            print("Thank you for using Contact Management System!")
            break
        else:
            print("Invalid choice! Please enter a number from 1 to 6.")


if __name__ == "__main__":
    main()
