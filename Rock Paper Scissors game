import random

# Rock, Paper, Scissors Game

options = ["rock", "paper", "scissors"]

user_score = 0
computer_score = 0
ties = 0

print("=" * 35)
print("  ROCK, PAPER, SCISSORS GAME")
print("=" * 35)
print("Rules:")
print("Rock beats Scissors")
print("Scissors beats Paper")
print("Paper beats Rock")

while True:
    # Get the user's choice
    user_choice = input(
        "\nChoose rock, paper, or scissors: "
    ).strip().lower()

    if user_choice not in options:
        print("Invalid choice! Please try again.")
        continue

    # Generate the computer's choice
    computer_choice = random.choice(options)

    # Display both choices
    print("\nYour choice:", user_choice.capitalize())
    print("Computer's choice:", computer_choice.capitalize())

    # Determine the winner
    if user_choice == computer_choice:
        print("Result: It's a tie!")
        ties += 1

    elif (
        (user_choice == "rock" and computer_choice == "scissors")
        or (user_choice == "scissors" and computer_choice == "paper")
        or (user_choice == "paper" and computer_choice == "rock")
    ):
        print("Result: Congratulations! You win!")
        user_score += 1

    else:
        print("Result: Computer wins!")
        computer_score += 1

    # Display the current score
    print("\n---------- SCORE ----------")
    print("Your score:", user_score)
    print("Computer score:", computer_score)
    print("Ties:", ties)
    print("---------------------------")

    # Ask whether to play again
    play_again = input(
        "\nDo you want to play again? (yes/no): "
    ).strip().lower()

    if play_again not in ("yes", "y"):
        break

# Display the final score
print("\n" + "=" * 35)
print("          FINAL SCORE")
print("=" * 35)
print("Your score:", user_score)
print("Computer score:", computer_score)
print("Ties:", ties)

if user_score > computer_score:
    print("Overall Result: You are the champion!")
elif computer_score > user_score:
    print("Overall Result: Computer wins the game!")
else:
    print("Overall Result: The game is a draw!")

print("Thanks for playing!")
